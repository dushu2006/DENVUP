{
  "name": "denvup-studio-site",
  "version": "1.0.0",
  "private": true,
  "description": "DENVUP \u2014 digital studio website. Website design, development, interactive experiences and digital solutions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "serve-check": "node scripts/serve-check.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "verify": "npm run typecheck && npm run build:fast && npm run smoke && npm run serve-check && npm run browser-check && npm run route-check && npm run inert-check",
    "test": "npm run verify",
    "route-check": "node scripts/route-check.mjs",
    "inert-check": "node scripts/inert-check.mjs",
    "perf-check": "node scripts/perf-check.mjs",
    "study-check": "python3 scripts/check-study-list.py"
  },
  "keywords": [
    "denvup",
    "agency",
    "website"
  ],
  "author": "DENVUP",
  "license": "SEE LICENSE IN ../../LICENSE",
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.180.0"
  }
}
