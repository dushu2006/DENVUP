{
  "name": "denvup-studio-site",
  "private": true,
  "version": "1.0.0",
  "description": "DENVUP \u2014 studio website, capabilities and live interaction demos.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-brand-assets.mjs",
    "content": "tsx scripts/prerender.ts",
    "dev": "npm run content && vite --host 0.0.0.0",
    "build": "vite build && tsx scripts/prerender.ts --prod",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "find dist -name index.html -print0 | xargs -0 npx html-validate",
    "qa": "npm run typecheck && npm run test && npm run build && npm run validate && npm run accept",
    "accept": "node scripts/browser/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "@types/node": "^22.10.0",
    "axe-core": "^4.10.2",
    "html-validate": "^11.16.4",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
